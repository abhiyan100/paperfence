# One of these is needed for the live attack (`paperfence attack`).
# The static probe (`paperfence scan`) needs neither.

# Option A: API key from https://platform.claude.com
ANTHROPIC_API_KEY=

# Option B: long-lived token from a Claude subscription. Run `claude setup-token` to get one.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: which model plays the adversary. Default is claude-sonnet-5.
PAPERFENCE_MODEL=
