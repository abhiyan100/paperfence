{
  "name": "paperfence",
  "version": "0.1.0",
  "description": "Find out which of your AI coding agent's rules are real gates and which are just wishes.",
  "type": "module",
  "bin": {
    "paperfence": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "site": "tsx scripts/site.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build && node scripts/check-package.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Abhiyan Poudel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhiyan100/paperfence.git"
  },
  "keywords": [
    "claude-code",
    "codex",
    "ai-agent",
    "agent-safety",
    "permissions",
    "hooks",
    "security",
    "policy",
    "guardrails",
    "llm"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.272",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "homepage": "https://paperfence.vercel.app",
  "bugs": {
    "url": "https://github.com/abhiyan100/paperfence/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
