{
  "name": "paperfence",
  "version": "0.1.0",
  "description": "Find out which of your AI coding agent's rules are real gates and which are just wishes.",
  "type": "module",
  "bin": {
    "paperfence": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
